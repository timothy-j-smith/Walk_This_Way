# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Python virtual environments
**/venv/
**/.venv/
__pycache__/
*.pyc

# Node modules
**/node_modules/

# Temporary session files
tmp/

# Chat export nightly log (created by launchd at 1 AM)
.cursor/docs/Chat_History/nightly_export.log

# Autopilot config (contains credential placeholders)
.autopilot.json


# Code Utility for OneStream
# OneStream connection configurations (contains sensitive data)
.onestream-metadata/connections.json
# VS Code extension packages
*.vsix
# OneStream file selections (user-specific)
.onestream-selections.json
# OneStream authentication tokens
onestream-token-*
# C# build artifacts
obj/
bin/
**/obj/
**/bin/

# ACE / Cursor hook artifacts (removed from workspace)
.cursor/hooks.json
.cursor/hooks/

# Private EPUB library — local copies only; do not commit purchased ebooks
private-mfa-program/epub-library/**/*.epub
private-mfa-program/epub-library/**/*.mobi
private-mfa-program/epub-library/**/*.azw3
private-mfa-program/epub-library/**/*.pdf

# Local runtime junk
logs/
thinking_server.log
.cursor/config/mcp.json.bak-*
