{
  "mcpServers": {
    "walk-this-way-files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/timothy/Library/Mobile Documents/com~apple~CloudDocs/Cursor/03_Novels/Walk This Way"
      ],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github",
        "--token",
        "env:GITHUB_TOKEN"
      ],
      "disabled": false
    },
    "gitkraken": {
      "command": "gk",
      "args": [
        "mcp"
      ],
      "disabled": false
    },
    "duckduckgo-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-duckduckgo-search"],
      "disabled": false
    },
    "google-workspace": {
      "command": "uvx",
      "args": ["workspace-mcp"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "env:GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "env:GOOGLE_OAUTH_CLIENT_SECRET"
      },
      "disabled": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "disabled": false
    },
    "compass-writing-guides": {
      "command": "/Users/timothy/Library/Mobile Documents/com~apple~CloudDocs/Cursor/03_Novels/Walk This Way/zz_COMPASS/MCP_Implementations/COMPASS_Writing_Guides_MCP/venv/bin/python",
      "args": [
        "/Users/timothy/Library/Mobile Documents/com~apple~CloudDocs/Cursor/03_Novels/Walk This Way/zz_COMPASS/MCP_Implementations/COMPASS_Writing_Guides_MCP/server.py"
      ],
      "disabled": false
    },
    "knowledge-graph-memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "disabled": false
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "env:FIRECRAWL_API_KEY"
      },
      "disabled": true
    },
    "pandoc": {
      "command": "uvx",
      "args": ["mcp-pandoc"],
      "disabled": false
    },
    "vectara": {
      "command": "npx",
      "args": ["-y", "vectara-mcp"],
      "env": {
        "VECTARA_API_KEY": "env:VECTARA_API_KEY",
        "VECTARA_ENV": "env:VECTARA_ENV"
      },
      "disabled": true
    }
  }
}
