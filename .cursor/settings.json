{
  "editor.wordWrap": "on",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontFamily": "Georgia, serif",
  
  "cursor.composer.enabled": true,
  "cursor.composer.multiFile": true,
  "cursor.composer.maxTokens": 8192,
  
  "cursor.textEditor.vocabulary": "extended",
  "cursor.textEditor.spellCheck": true,
  "cursor.textEditor.grammarCheck": true,
  
  "cursor.agents.enabled": true,
  "cursor.agents.default": "creative-collaborator",
  
  "files.associations": {
    "*.md": "markdown"
  },
  
  "markdown.preview.fontSize": 16,
  "markdown.preview.lineHeight": 1.8
}
